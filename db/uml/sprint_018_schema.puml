    + ambient_temperature: DOUBLE
    + internal_energy: DOUBLE
    + entropy: DOUBLE
    + exergy: DOUBLE
    + stock_carbon: DOUBLE
    + stock_nitrogen: DOUBLE
    + stock_phosphorus: DOUBLE
    + stock_h2o: DOUBLE
    + entropy_generation_rate: DOUBLE
    + exergy_destruction_rate: DOUBLE
    + invariants_valid: BOOLEAN
  }

  class boundary_flux_vectors {
    + flux_id: UUID <<PK>>
    + vector_id: UUID <<FK>>
    + radiative_flux: DOUBLE
    + sensible_heat_flux: DOUBLE
    + latent_heat_flux: DOUBLE
    + mass_flux_carbon: DOUBLE
    + mass_flux_nitrogen: DOUBLE
    + mass_flux_phosphorus: DOUBLE
    + mass_flux_h2o: DOUBLE
  }

