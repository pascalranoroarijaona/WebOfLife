title Web of Life - Sprint 018: Thermodynamic State Vector & Nonequilibrium Exergy Architecture

package "src.thermodynamics" {
  
  interface BoundaryFluxVector {
    + radiativeFlux: number
    + sensibleHeatFlux: number
    + latentHeatFlux: number
    + massFluxRates: [number, number, number, number]
  }

  interface ThermodynamicStateVector {
    + time: number
    + temperature: number
    + ambientTemperature: number
    + internalEnergy: number
    + entropy: number
    + exergy: number
    + elementalStocks: [number, number, number, number]
    + boundaryFluxes: BoundaryFluxVector
    + entropyGenerationRate: number
    + exergyDestructionRate: number
  }

  interface IThermodynamicMonadProcess {
    + id: string
    + name: string
    + step(currentState: ThermodynamicStateVector, dt: number): ThermodynamicStateVector
    + validateInvariants(state: ThermodynamicStateVector): boolean
  }

  class ThermodynamicMonadProcessBase {
    # id: string
    # name: string
    + step(currentState: ThermodynamicStateVector, dt: number): ThermodynamicStateVector
    + validateInvariants(state: ThermodynamicStateVector): boolean
    # computeFirstLaw(state: ThermodynamicStateVector, dt: number): number
    # computeSecondLaw(state: ThermodynamicStateVector, dt: number): number
    # applyGouyStodolaTheorem(sGen: number, t0: number): number
  }

  IThermodynamicMonadProcess <|.. ThermodynamicMonadProcessBase
  ThermodynamicStateVector *-- BoundaryFluxVector : contains
  ThermodynamicMonadProcessBase ..> ThermodynamicStateVector : transitions
}

package "Database Schema (SQL)" {
  
  class thermodynamic_monad_processes {
    + monad_id: UUID <<PK>>
    + process_name: VARCHAR
    + process_status: process_status
    + cumulative_exergy_efficiency: DOUBLE
