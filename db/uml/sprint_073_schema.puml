        +latRad: number
        +lngRad: number
        --
        +fromDegrees(latDeg: number, lngDeg: number): SphericalCoordinate
        +toUnitVector(): Vector3D
    }

    class Vector3D {
        +x: number
        +y: number
        +z: number
        --
        +dot(other: Vector3D): number
        +cross(other: Vector3D): Vector3D
