@startuml
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE

title Sprint 043: Thermodynamic State Vector & Non-Negative Entropy Architecture

package "src.thermodynamics" {
    
    interface EntropyInspectable {
        + readonly entropy: number
        + [key: string]: unknown
    }

    type Result<T, E> = 
        | { success: true; value: T }
        | { success: false; error: E }

    class StateValidator {
        + {static} assertNonNegativeEntropy<T extends EntropyInspectable>(state: T): Result<T, string>
    }

    class ThermodynamicMonadProcess {
        - currentState: ThermodynamicStateVector
        + executePipeline(state: EntropyInspectable): Result<EntropyInspectable, string>
    }
}

package "Database Schema" {
    class ThermodynamicStateVectorTable {
        + vector_id: UUID
        + pod_id: UUID
        + cycle_index: BIGINT
        + entropy: DOUBLE PRECISION {S >= 0}
        + mass_energy_total: DOUBLE PRECISION
        + state_payload: JSONB
        + validated_at: TIMESTAMPTZ
    }

    class MonadExecutionLogsTable {
        + execution_id: UUID
        + vector_id: UUID
        + pipeline_stage: VARCHAR
        + success: BOOLEAN
        + error_message: TEXT
        + executed_at: TIMESTAMPTZ
    }

    class ThermodynamicBlockchainBlocksTable {
        + block_index: BIGINT
        + previous_hash: VARCHAR
        + block_hash: VARCHAR
        + merkle_root: VARCHAR
        + entropy_ledger_state: DOUBLE PRECISION {S >= 0}
        + validator_signature: VARCHAR
    }
}

EntropyInspectable <|.. ThermodynamicMonadProcess : inspects
StateValidator ..> Result : returns
StateValidator ..> EntropyInspectable : validates
ThermodynamicMonadProcess --> StateValidator : guards via
ThermodynamicStateVectorTable -- MonadExecutionLogsTable : logs execution
ThermodynamicBlockchainBlocksTable "1" *-- "*" ThermodynamicStateVectorTable : anchors immutable state

@enduml