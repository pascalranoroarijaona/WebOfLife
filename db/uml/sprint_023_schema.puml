spatial_monad_stocks }-- h3_resolution_tiers : references tier [0-15]
thermodynamic_stock_transactions --> spatial_monad_stocks : parent_stock_id
thermodynamic_stock_transactions --> spatial_monad_stocks : target_stock_id

