    +solarEpochCycle: long
    +entropyDelta: decimal
}

class SpatialMonadStock {
    +stockId: UUID
    +validationId: UUID
    +trophicLayer: string
    +energyAllocation: decimal
    +createdAt: DateTime
}

class SpatialBlockchainLedger {
    +blockId: long
    +previousHash: string
    +currentHash: string
    +validationId: UUID
