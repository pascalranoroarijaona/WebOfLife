title Web of Life - Center Aperture Invariance & Spatial Monad Schema (Sprint 088)

enum H3DirectionDigit {
    CENTER_0 = 0
    AXIS_1 = 1
    AXIS_2 = 2
    AXIS_3 = 3
    AXIS_4 = 4
    AXIS_5 = 5
    AXIS_6 = 6
}

enum SpatialApertureMode {
    APERTURE_INVARIANT_CENTER
    LATERAL_DISPLACEMENT
    VACUOUS_IDENTITY
}

enum TrophicLevelType {
    PRIMARY_PRODUCER
    PRIMARY_CONSUMER
    SECONDARY_CONSUMER
    TERTIARY_CONSUMER
    APEX_PREDATOR
    DECOMPOSER_DETRITIVORE
}

enum FluxDirectionType {
    INTERNAL_VERTICAL_DISSIPATION
    CONCENTRIC_ACCUMULATION
    LATERAL_HEX_INTERCHANGE
    RADIATIVE_OUTFLOW
}

class "H3Adjacency" as H3Adjacency <<utility>> {
    +hasZeroApertureSequence(digits: readonly number[]): boolean
    +computeLateralDisplacement(path: readonly number[]): number
    +isParentCentroidPreserved(path: readonly number[]): boolean
}

class "H3HierarchicalCell" as H3HierarchicalCell {
    +cell_id: string [PK]
    +resolution: int
    +parent_cell_id: string [FK]
    +centroid_geom: Point
    +boundary_geom: Polygon
    +is_center_child: boolean
    +aperture_digit: H3DirectionDigit
    +created_at: timestamp
}

class "H3TraversalPath" as H3TraversalPath {
    +path_id: UUID [PK]
    +origin_cell_id: string [FK]
    +target_cell_id: string [FK]
    +origin_resolution: int
    +target_resolution: int
    +digit_sequence: int[]
    +sequence_length: int
    +has_zero_aperture_sequence: boolean
    +aperture_mode: SpatialApertureMode
