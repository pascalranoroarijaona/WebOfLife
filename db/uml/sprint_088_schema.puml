}

class "SpatialFluxMonad<T>" as SpatialFluxMonad {
    -state: T
    -apertureInvariant: boolean
    -lateralFluxTensor: double
    +unit(value: T): SpatialFluxMonad<T>
    +bind<U>(transform: (v: T) => SpatialFluxMonad<U>): SpatialFluxMonad<U>
    +enforceZeroApertureConservation(): boolean
    +evaluateNoLateralFlux(): boolean
}

