package "Database & Blockchain Schema (db/schema.sql)" {
    
    class ThermodynamicStateRecord {
        + state_id: UUID
        + entity_id: UUID
        + internal_energy: NUMERIC
        + entropy: NUMERIC
        + temperature: NUMERIC
        + ambient_temperature: NUMERIC
        + exergy: NUMERIC
        + recorded_at: TIMESTAMP
    }

    class ThermodynamicFluxRecord {
        + flux_id: UUID
        + entity_id: UUID
        + free_energy_import_rate: NUMERIC
        + entropy_export_rate: NUMERIC
        + internal_entropy_gen_rate: NUMERIC
        + exergy_destruction_rate: NUMERIC
        + measured_at: TIMESTAMP
    }

    class ThermodynamicBlock {
        + block_id: UUID
        + block_index: BIGINT
        + previous_hash: VARCHAR
        + merkle_root: VARCHAR
        + solar_input_monad_stock: NUMERIC
        + timestamp: TIMESTAMP
        + block_signature: VARCHAR
    }

    class ThermodynamicTransaction {
        + tx_id: UUID
        + block_id: UUID
        + source_entity_id: UUID
        + target_entity_id: UUID
        + energy_transferred_joules: NUMERIC
        + entropy_change_jk: NUMERIC
        + exergy_destroyed_joules: NUMERIC
        + second_law_verified: BOOLEAN
        + tx_timestamp: TIMESTAMP
    }

    ThermodynamicBlock "1" *-- "*" ThermodynamicTransaction : contains >
