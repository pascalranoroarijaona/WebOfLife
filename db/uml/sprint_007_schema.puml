  ERR_H3_INVALID_LENGTH = 0x02
  ERR_H3_INVALID_CHARACTERS = 0x03
  ERR_H3_INVALID_RESOLUTION = 0x04
  ERR_H3_INVALID_BASE_CELL = 0x05
  ERR_H3_OUT_OF_RANGE = 0x06
}

