package "Spatial DGGS Adjacency Domain (src/spatial)" {

    class H3Adjacency <<module>> {
        +isPentagonCell(cellId: string): boolean
        +isExpectedNeighborCountForCell(cellId: string, count: number): boolean
        +assertValidNeighborCountForCell(cellId: string, neighbors: unknown): void
    }

    note right of H3Adjacency::assertValidNeighborCountForCell
      <b>Runtime Assertion Contract:</b>
      1. Assert Array.isArray(neighbors) -> throws TypeError
      2. count = neighbors.length
      3. Assert isExpectedNeighborCountForCell(cellId, count)
         -> 5 for 12 spherical pentagons
         -> 6 for regular hexagons
         -> throws RangeError on invariant breach
      4. Narrows neighbors to readonly unknown[]
    end note

    class H3Grid <<entity>> {
        -resolution: number
        +getCell(cellId: string): DggsCell
        +getDirectNeighbors(cellId: string): string[]
        +validateTopology(cellId: string): boolean
    }

    class SpatialFluxMonad<T> <<monad>> {
        -cellId: string
        -stocks: ThermodynamicStock
        -neighbors: readonly string[]
        -fluxVector: Map<string, number>
        +bind<R>(fn: (state: ThermodynamicStock) => SpatialFluxMonad<R>): SpatialFluxMonad<R>
        +assertNeighborhoodIntegrity(): void
        +computeBoundaryDivergence(): number
        +runFluxStep(deltaT: number): SpatialFluxMonad<T>
    }
}

