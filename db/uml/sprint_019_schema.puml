title Web of Life - Sprint 019: Thermodynamic State Vector & Exergy Architecture

package "src/thermodynamics" {
  
  interface BoundaryFluxVector {
    + solarRadiationFlux: number
    + thermalRadiationFlux: number
    + sensibleHeatFlux: number
    + latentHeatFlux: number
    + massFluxes: Map<string, number>
  }

  interface ThermodynamicStateVector {
    + internalEnergy: number
    + entropy: number
    + temperature: number
    + ambientTemperature: number
    + entropyGenerationRate: number
    + exergyDestructionRate: number
    + exergy: number
    + boundaryFluxes: BoundaryFluxVector
  }

  interface ThermodynamicDerivativeResult {
    + dInternalEnergy: number
    + dEntropy: number
    + entropyGenerationRate: number
    + exergyDestructionRate: number
    + massStockDeltas: Map<string, number>
  }

  interface IThermodynamicProcessMonad {
    + {readonly} processId: string
    + evaluate(state: ThermodynamicStateVector, dt: number): ThermodynamicDerivativeResult
    + transit(state: ThermodynamicStateVector, dt: number): ThermodynamicStateVector
  }

  abstract class BaseThermodynamicProcessMonad {
    + {abstract} {readonly} processId: string
    + {abstract} evaluate(state: ThermodynamicStateVector, dt: number): ThermodynamicDerivativeResult
    + transit(state: ThermodynamicStateVector, dt: number): ThermodynamicStateVector
  }

  IThermodynamicProcessMonad <|.. BaseThermodynamicProcessMonad
  ThermodynamicStateVector *-- BoundaryFluxVector : contains
  BaseThermodynamicProcessMonad ..> ThermodynamicStateVector : consumes/transforms
  BaseThermodynamicProcessMonad ..> ThermodynamicDerivativeResult : produces
}

