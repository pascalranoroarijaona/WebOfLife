title Web of Life - Sprint 013: Thermodynamic State Vector UML Schema

package "src.thermodynamics" {
  
  interface IBoundaryFluxArray {
    + solarInput: number
    + thermalRadiationOut: number
    + matterEnthalpyFlux: number
    + netHeatFlux: number
  }

  interface IExergyMetrics {
    + T_0: number
    + entropyGenerationRate: number
    + exergyDestructionRate: number
    + totalExergy: number
  }

  interface IThermodynamicStateVector {
    + tick: number
    + internalEnergy: number
    + totalEntropy: number
    + boundaryFluxes: IBoundaryFluxArray
    + exergyMetrics: IExergyMetrics
    + validateFirstLaw(dt: number, previousEnergy: number): boolean
    + validateSecondLaw(): boolean
  }

  class ThermodynamicStateEngine {
    - tick: number
    - internalEnergy: number
    - totalEntropy: number
    - boundaryFluxes: IBoundaryFluxArray
    - exergyMetrics: IExergyMetrics
    + validateFirstLaw(dt: number, previousEnergy: number): boolean
    + validateSecondLaw(): boolean
    + evolve(dt: number): IThermodynamicStateVector
  }

  IThermodynamicStateVector *-- IBoundaryFluxArray : contains
  IThermodynamicStateVector *-- IExergyMetrics : contains
  ThermodynamicStateEngine ..|> IThermodynamicStateVector : implements
}

package "src.cycles" {
  class BaseCycle {
    + processCycle(vector: IThermodynamicStateVector): IThermodynamicStateVector
  }
  class CarbonCycle
  class NitrogenCycle
  class PhosphorusCycle
  class WaterCycle

  BaseCycle <|-- CarbonCycle
  BaseCycle <|-- NitrogenCycle
  BaseCycle <|-- PhosphorusCycle
  BaseCycle <|-- WaterCycle
  
  BaseCycle ..> IThermodynamicStateVector : threads monad
}

