package "Spatial DGGS Kinematics (src/spatial/)" {
    interface IH3ApertureInspector {
        + hasNonZeroApertureDigits(index: bigint | string, resolution?: number): boolean
        + getFirstNonZeroApertureResolution(index: bigint | string): number | null
        + getApertureDigit(index: bigint | string, resolution: number): number
        + analyzeApertureStructure(index: bigint | string): ApertureAnalysisResult
    }

    class ApertureAnalysisResult <<ValueObject>> {
        + index: string
        + resolution: number
        + hasNonZeroDigits: boolean
        + firstNonZeroResolution: number | null
        + nonZeroDigitCount: number
        + digitSequence: readonly number[]
    }

    class H3AdjacencyCoordinator implements IH3ApertureInspector {
        - adjacencyMatrixMap: Map<string, string[]>
        - resolutionCache: Map<string, number>
        + hasNonZeroApertureDigits(index: bigint | string, resolution?: number): boolean
        + getFirstNonZeroApertureResolution(index: bigint | string): number | null
        + getApertureDigit(index: bigint | string, resTier: number): number
        + analyzeApertureStructure(index: bigint | string): ApertureAnalysisResult
        + getNeighbors(index: bigint | string): string[]
        + computeBitwiseApertureMask(resolution: number): bigint
    }

    class Vector3D <<ValueObject>> {
        + x: number
        + y: number
        + z: number
        + {static} ZERO: Vector3D
        + magnitude(): number
        + add(v: Vector3D): Vector3D
    }
}

package "Monadic Thermodynamic Stocks & Fluxes (src/monads/)" {
    class SpatialMonad<TStock> {
        + patchIndex: string
        + stock: TStock
        + timestamp: Date
        + map<U>(fn: (stock: TStock) => U): SpatialMonad<U>
        + flatMap<U>(fn: (stock: TStock) => SpatialMonad<U>): SpatialMonad<U>
    }

    class ThermodynamicStock <<Entity>> {
        + biomassKg: number
        + enthalpyJoules: number
        + entropyJK: number
        + waterLiters: number
        + carbonKg: number
        + isConservedWith(other: ThermodynamicStock): boolean
    }

    class SpatialFluxMonad {
        + sourceCell: string
        + targetParentCell: string
        + transferredStock: ThermodynamicStock
        + driftVector: Vector3D
        + computeCoarseningDriftVector(source: string, target: string): Vector3D
        + executeConservativeTransfer(): SpatialMonad<ThermodynamicStock>
    }
}

