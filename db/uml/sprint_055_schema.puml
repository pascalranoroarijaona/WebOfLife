@startuml
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F9F9F9
skinparam classBorderColor #333333

title Web of Life - Sprint 055: Thermodynamic State Vector Stock Conservation Delta Calculator

package "src.thermodynamics" {
  
  enum ElementalType {
    C
    N
    P
    H2O
    ENERGY
  }

  interface FluxVector {
    +sourceId: string
    +targetId: string
    +element: ElementalType
    +rate: number
  }

  interface DeltaCalculationResult {
    +element: string
    +expectedDelta: number
    +netInflow: number
    +netOutflow: number
    +isConserved: boolean
  }

  class StateVector {
    -vectorId: string
    -stocks: Map<string, number>
    -entropy: number
    -freeEnergy: number
    +getAllStocks(): Map<string, number>
    +getStock(stockId: string): number
  }

  class ThermodynamicStateValidator {
    {static} +calculateDelta(initialState: StateVector, fluxes: FluxVector[], deltaTime: number): Map<string, DeltaCalculationResult>
  }

  class MonadProcess {
    -processId: string
    +execute(state: StateVector): StateVector
  }
}

package "Database & Ledger Schema" {
  class ThermodynamicStateVectorTable {
    +vector_id: UUID
    +entity_id: string
    +timestamp: DateTime
    +entropy_j_k: number
    +free_energy_j: number
  }

  class ThermodynamicStockTable {
    +stock_id: string
    +vector_id: UUID
    +element: ElementalType
    +stock_value: number
  }

  class FluxVectorTable {
    +flux_id: UUID
    +source_id: string
    +target_id: string
    +element: ElementalType
    +rate: number
  }

  class DeltaCalculationLedgerTable {
    +calculation_id: UUID
    +vector_id: UUID
    +stock_id: string
    +expected_delta: number
    +is_conserved: boolean
  }

  class ThermodynamicBlockchainBlock {
    +block_index: int
    +block_hash: string
    +previous_block_hash: string
    +merkle_root: string
    +validator_signature: string
  }
}

-- Relationships & Dependencies --
FluxVector --> ElementalType : uses
DeltaCalculationResult --> ElementalType : classifies
ThermodynamicStateValidator ..> StateVector : inspects
ThermodynamicStateValidator ..> FluxVector : processes
ThermodynamicStateValidator ..> DeltaCalculationResult : produces
MonadProcess --> StateVector : transforms

ThermodynamicStateVectorTable "1" *-- "*" ThermodynamicStockTable : contains
ThermodynamicStateVectorTable "1" *-- "*" DeltaCalculationLedgerTable : logs
ThermodynamicStockTable "1" -- "*" FluxVectorTable : source/target
ThermodynamicStateVectorTable "1" o-- "1" ThermodynamicBlockchainBlock : anchored in

@enduml