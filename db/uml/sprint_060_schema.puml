        +validateZeroRadialLeakage(): boolean
    }

    class AdvectiveFacetFlux {
        +sourceIndex: string
        +targetIndex: string
        +facetNormalVelocity: number
        +carbonFluxMol: number
        +nitrogenFluxMol: number
        +waterFluxKg: number
        +phosphorusFluxMol: number
        +energyFluxJoules: number
        +entropyDissipationRate: number
        __
        +computeFirstLawFlow(sourceStock: ConservativeStockTensor, vPerp: Vector3D): void
    }
}

package "Blockchain Consensus & Ledger" {
